programa {
  funcao inicio() {
    cadeia mae = "Tess"
    cadeia filha = "Anna"
    cadeia auxiliar = ""

    escreva ("Antes da troca Mae = ", mae ," e filha = ", filha, "\n")

    auxiliar = mae
    mae = filha
    filha = auxiliar

    escreva ("Depois da troca Mae = ", mae , " e filha = ", filha)

  }
}
